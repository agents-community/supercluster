# agentplane brain image, pi variant: ONLY the pi harness SDK.
#
# Per-harness images keep the sandbox rootfs lean — gVisor's gofer pays a
# per-file cost at workload creation, and stacking every harness's node_modules
# in one image pushed restores past the RPC deadline (observed with :g9).
# The AgentSpec's `image:` field selects this variant for `harness: pi` agents;
# the harness registry loads lazily, so absent SDKs are never imported.
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# PINNED. With @latest, two builds of the same file ship different harness
# behaviour — that silently changed a sandbox-boundary control once already
# (see agentplane/brain/Dockerfile). Bump deliberately.
ARG PI_AGENT_VERSION=0.83.0
# @modelcontextprotocol/sdk: pi talks to the hand over MCP (#73), so its tools
# execute in the sandbox rather than in the brain alongside the model key.
RUN npm install "@earendil-works/pi-coding-agent@${PI_AGENT_VERSION}" \
      @modelcontextprotocol/sdk \
      @opentelemetry/api@^1 @opentelemetry/sdk-node @opentelemetry/exporter-trace-otlp-grpc \
  && npm cache clean --force

# Every file runtime.mjs or a harness imports must be listed here. A missing
# one fails at ACTOR START, not at build: node resolves imports lazily and
# `docker build` is perfectly happy. otel.mjs was missing from the pi and codex
# images — invisible only because those had not been rebuilt since runtime.mjs
# started importing it.
COPY server.mjs runtime.mjs identity.mjs otel.mjs approval.mjs /app/
COPY harness /app/harness
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PORT=8080
ENTRYPOINT ["/entrypoint.sh"]
