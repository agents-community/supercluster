# agentplane brain image, codex variant: ONLY the Codex harness SDK.
#
# One image per harness (see Dockerfile.pi for the rationale): gVisor's gofer
# pays a per-file cost at workload creation, and a multi-harness node_modules
# pushed restores past the RPC deadline. The harness registry loads lazily, so
# absent SDKs are never imported.
FROM node:20-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git \
  && rm -rf /var/lib/apt/lists/*


WORKDIR /app
# PINNED. With @latest, two builds of the same file ship different harness
# behaviour — that silently changed a sandbox-boundary control once already
# (see agentplane/brain/Dockerfile). Bump deliberately.
ARG CODEX_SDK_VERSION=0.146.0
RUN npm install "@openai/codex-sdk@${CODEX_SDK_VERSION}" \
      @opentelemetry/api@^1 @opentelemetry/sdk-node @opentelemetry/exporter-trace-otlp-grpc && npm cache clean --force

# Every file runtime.mjs or a harness imports must be listed here. A missing
# one fails at ACTOR START, not at build: node resolves imports lazily and
# `docker build` is perfectly happy. otel.mjs was missing from the pi and codex
# images — invisible only because those had not been rebuilt since runtime.mjs
# started importing it.
COPY server.mjs runtime.mjs identity.mjs otel.mjs /app/
COPY harness /app/harness
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PORT=8080
ENTRYPOINT ["/entrypoint.sh"]
