# Every value that ties a deployment to one GCP account.
#
# Copy this to `config.env`, fill it in, and `source` it before running
# infra/render.sh:
#
#   cp infra/config.env.example infra/config.env   # then edit
#   source infra/config.env && ./infra/render.sh | kubectl apply -f -
#
# `config.env` is gitignored so real ids never land in the repo. Nothing else in
# the repo should contain a project id, bucket name or IP — if you find one, it
# is a bug (see infra/BOOTSTRAP.md).

# --- identity -----------------------------------------------------------------
# The GCP project everything lives in.
export PROJECT_ID="your-project-id"
# The project NUMBER, used to build Workload Identity principals. Find it with:
#   gcloud projects describe "$PROJECT_ID" --format='value(projectNumber)'
export PROJECT_NUMBER="000000000000"

# --- where -------------------------------------------------------------------
export CLUSTER_NAME="your-cluster"
export CLUSTER_LOCATION="us-central1-c"
export REGION="us-central1"

# --- storage -----------------------------------------------------------------
# Snapshots, transcripts and escrow. Substrate creates this at install time;
# it must already exist before serve starts.
export SNAPSHOT_BUCKET="your-snapshot-bucket-${PROJECT_ID}"

# --- images ------------------------------------------------------------------
# Registry prefix. Every image tag below is appended to this.
export IMAGE_REPO="gcr.io/${PROJECT_ID}/ate-images"
export SERVE_TAG="v54"
# The executor image: where model-written commands run, separate from the
# gateway that holds credentials (#74).
export EXEC_TAG="z1"
export GITPROXY_TAG="g5"
# The broker: mediator between brain and hand (MCP + credentials + approval).
export BROKER_TAG="b6"
export BRAIN_CC_TAG="c10"
export BRAIN_CODEX_TAG="x1"
export BRAIN_PI_TAG="p6"
# Digest-pinned brain images serve resolves by harness when an AgentSpec omits
# `image:` (authors never pin a digest). Fill after building — resolve with:
#   gcloud container images describe "$IMAGE_REPO/agentplane-brain-cc:$BRAIN_CC_TAG" --format='value(image_summary.digest)'
export BRAIN_CC_IMAGE="${IMAGE_REPO}/agentplane-brain-cc@sha256:REPLACE_WITH_DIGEST"
export BRAIN_PI_IMAGE="${IMAGE_REPO}/agentplane-brain-pi@sha256:REPLACE_WITH_DIGEST"
export BRAIN_CODEX_IMAGE="${IMAGE_REPO}/agentplane-brain-codex@sha256:REPLACE_WITH_DIGEST"

# --- runtime -----------------------------------------------------------------
# The hand ActorTemplate new sessions pair with. Versioned because a hand image
# change needs a fresh golden — bump when you rebuild the hand.
export HAND_TEMPLATE="hand-v15"
# Public entry point. After `gcloud compute addresses create agentplane-ip`,
# put the reserved address here.
export INGRESS_IP="0.0.0.0"
# Hostname for the HTTPS cutover. Until a domain exists, nip.io off the IP.
export INGRESS_HOST="${INGRESS_IP}.nip.io"

# --- observability ------------------------------------------------------------
export OTEL_ENDPOINT="http://opentelemetry-collector.otel-system.svc:4317"
