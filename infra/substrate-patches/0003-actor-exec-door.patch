+// ExecActor runs a one-shot command inside a container of a RUNNING actor and
+// returns its captured output. It resolves which worker/ateom holds the actor,
+// then forwards to that node's atelet (Herder.Exec → Ateom.ExecWorkload →
+// `runsc exec`). The command runs in the sandbox driven entirely from outside
+// the actor, so a workload container need not host an agent to run commands.
+//
+// ExecActor does NOT resume a sleeping actor: the caller (e.g. the broker on a
+// live turn) is expected to have a running actor already.
+func (s *Service) ExecActor(ctx context.Context, req *ateapipb.ExecActorRequest) (*ateapipb.ExecActorResponse, error) {
+	if req.GetActor() == nil {
+		return nil, status.Error(codes.InvalidArgument, "actor is required")
+	}
+	if len(req.GetArgv()) == 0 {
+		return nil, status.Error(codes.InvalidArgument, "argv is required")
+	}
+	actorRef := resources.ActorRefFromObjectRef(req.GetActor())
+	setSpanActorRefAttributes(ctx, actorRef)
+
+	actor, err := s.persistence.GetActor(ctx, actorRef)
+	if err != nil {
+		if errors.Is(err, store.ErrNotFound) {
+			return nil, status.Errorf(codes.NotFound, "Actor %s not found", actorRef)
+		}
+		return nil, err
+	}
+	if actor.GetStatus() != ateapipb.Actor_STATUS_RUNNING {
+		return nil, status.Errorf(codes.FailedPrecondition,
+			"Actor %s is not running (status %v); ExecActor does not resume it", actorRef, actor.GetStatus())
+	}
+	if actor.GetAteomPodNamespace() == "" || actor.GetAteomPodName() == "" || actor.GetAteomPodUid() == "" {
+		return nil, status.Errorf(codes.FailedPrecondition, "Actor %s has no worker assignment", actorRef)
+	}
+
+	conn, err := s.dialer.DialForWorker(actor.GetAteomPodNamespace(), actor.GetAteomPodName())
+	if err != nil {
+		return nil, fmt.Errorf("while getting atelet conn for worker pod: %w", err)
+	}
+	client := ateletpb.NewAteomHerderClient(conn)
+
+	resp, err := client.Exec(ctx, &ateletpb.ExecRequest{
+		TargetAteomUid: actor.GetAteomPodUid(),
+		ContainerName:  req.GetContainerName(),
+		Argv:           req.GetArgv(),
+		Cwd:            req.GetCwd(),
+		Env:            req.GetEnv(),
+		TimeoutMs:      req.GetTimeoutMs(),
+	})
+	if err != nil {
+		return nil, fmt.Errorf("while calling atelet.Exec: %w", err)
+	}
+	setSpanActorAttributes(ctx, actor)
+	return &ateapipb.ExecActorResponse{
+		Stdout:   resp.GetStdout(),
+		Stderr:   resp.GetStderr(),
+		ExitCode: resp.GetExitCode(),
+	}, nil
+}
