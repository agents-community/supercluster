+// ExecWorkload runs a one-shot command inside a container of the running
+// workload via `runsc exec` and returns its captured output. This is the door
+// that lets a command run in the sandbox from OUTSIDE the actor, so a workload
+// container need not host an agent that runs commands against it. A non-zero
+// command exit is a normal result (ExitCode set); only a failure to run runsc
+// itself is an RPC error.
+func (s *AteomService) ExecWorkload(ctx context.Context, req *ateompb.ExecWorkloadRequest) (*ateompb.ExecWorkloadResponse, error) {
+	if len(req.GetArgv()) == 0 {
+		return nil, fmt.Errorf("ExecWorkload: argv is required")
+	}
+	// The runsc binary + actor UID come from the workload this ateom is currently
+	// executing (set by RunWorkload/RestoreWorkload), not from the request.
+	runscPath, actorUID := s.execTarget()
+	if runscPath == "" || actorUID == "" {
+		return nil, fmt.Errorf("ExecWorkload: no executing workload to exec in")
+	}
+	// No s.lock: `runsc exec` runs alongside the live sandbox, and a long command
+	// must not block checkpoint/restore. cmdExec takes reapLock (shared) like the
+	// other runsc subcommands, which is the concurrency protection that matters.
+	rcmd := &runsc{
+		path:     runscPath,
+		actorUID: actorUID,
+	}
+	timeout := time.Duration(req.GetTimeoutMs()) * time.Millisecond
+	if timeout <= 0 {
+		timeout = 120 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+
+	stdout, stderr, code, err := rcmd.cmdExec(ctx, req.GetContainerName(), req.GetCwd(), req.GetEnv(), req.GetArgv())
+	if err != nil {
+		return nil, fmt.Errorf("ExecWorkload: %w", err)
+	}
+	return &ateompb.ExecWorkloadResponse{Stdout: stdout, Stderr: stderr, ExitCode: int32(code)}, nil
+}
