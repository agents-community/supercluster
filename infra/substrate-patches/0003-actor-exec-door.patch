+// cmdExec runs a one-shot command inside an already-running container via
+// `runsc exec` and returns the command's stdout, stderr and exit code.
+//
+// This is the primitive that lets a command run in the sandbox from OUTSIDE the
+// actor — no in-actor agent needed. A non-zero exit is a RESULT (returned with
+// exitCode set, err nil); only a failure to run runsc itself is an error.
+//
+// runsc's own diagnostic logs are routed to /dev/null (-log), not stderr, so
+// they never mix into the command's captured stderr. --alsologtostderr is
+// deliberately omitted for the same reason.
+func (r *runsc) cmdExec(ctx context.Context, containerName, cwd string, env, argv []string) (stdout, stderr []byte, exitCode int, err error) {
+	reapLock.RLock()
+	defer reapLock.RUnlock()
+
+	args := []string{
+		"-log-format", "json",
+		"-log", "/dev/null",
+		"-root", ateompath.RunSCStateDir(r.actorUID),
+		"exec",
+	}
+	if cwd != "" {
+		args = append(args, "--cwd", cwd)
+	}
+	for _, e := range env {
+		args = append(args, "--env", e)
+	}
+	args = append(args, containerName)
+	args = append(args, argv...)
+
+	cmd := exec.CommandContext(ctx, r.path, args...)
+	var so, se bytes.Buffer
+	cmd.Stdout = &so
+	cmd.Stderr = &se
+	err = cmd.Run()
+	stdout, stderr = so.Bytes(), se.Bytes()
+	if err != nil {
+		var ee *exec.ExitError
+		if errors.As(err, &ee) {
+			return stdout, stderr, ee.ExitCode(), nil
+		}
+		return stdout, stderr, -1, fmt.Errorf("while running `runsc exec`: %w", err)
+	}
+	return stdout, stderr, 0, nil
+}
