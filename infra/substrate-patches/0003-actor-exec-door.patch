+// Exec forwards a one-shot command to the ateom hosting the actor, which runs
+// it inside the sandbox via `runsc exec` and returns its captured output. This
+// is the outside-in exec path: the caller (ate-api's Control.ExecActor) resolves
+// which ateom holds the actor and passes it as target_ateom_uid; nothing of the
+// caller's needs to live inside the actor.
+func (s *AteomHerder) Exec(ctx context.Context, req *ateletpb.ExecRequest) (*ateletpb.ExecResponse, error) {
+	if err := resources.ValidateAteomUID(req.GetTargetAteomUid()); err != nil {
+		return nil, err
+	}
+	client, err := s.dialAteom(ctx, req.GetTargetAteomUid())
+	if err != nil {
+		return nil, err
+	}
+	resp, err := client.ExecWorkload(ctx, &ateompb.ExecWorkloadRequest{
+		ContainerName: req.GetContainerName(),
+		Argv:          req.GetArgv(),
+		Cwd:           req.GetCwd(),
+		Env:           req.GetEnv(),
+		TimeoutMs:     req.GetTimeoutMs(),
+	})
+	if err != nil {
+		return nil, fmt.Errorf("while calling ateom.ExecWorkload: %w", err)
+	}
+	return &ateletpb.ExecResponse{
+		Stdout:   resp.GetStdout(),
+		Stderr:   resp.GetStderr(),
+		ExitCode: resp.GetExitCode(),
+	}, nil
+}
