# Every value that ties this deployment to one GCP account.
#
# Copy, edit, and `source` it before running infra/render.sh. Nothing else in
# the repo should contain a project id, bucket name or IP — if you find one,
# it is a bug (see infra/BOOTSTRAP.md).

# --- identity -----------------------------------------------------------------
# The GCP project everything lives in.
export PROJECT_ID="project-28d42275-7fed-43e6-a9a"
# The project NUMBER, used to build Workload Identity principals. Find it with:
#   gcloud projects describe "$PROJECT_ID" --format='value(projectNumber)'
export PROJECT_NUMBER="536649565726"

# --- where -------------------------------------------------------------------
export CLUSTER_NAME="substrate-poc"
export CLUSTER_LOCATION="us-central1-c"
export REGION="us-central1"

# --- storage -----------------------------------------------------------------
# Snapshots, transcripts and escrow. Substrate creates this at install time;
# it must already exist before serve starts.
export SNAPSHOT_BUCKET="snapshot-substrate-test-${PROJECT_ID}"

# --- images ------------------------------------------------------------------
# Registry prefix. Every image tag below is appended to this.
export IMAGE_REPO="gcr.io/${PROJECT_ID}/ate-images"
export SERVE_TAG="v30"
export HAND_TAG="h14"
export GITPROXY_TAG="g5"
export BRAIN_CC_TAG="c6"
export BRAIN_CODEX_TAG="x1"
export BRAIN_PI_TAG="p1"

# --- runtime -----------------------------------------------------------------
# The hand ActorTemplate new sessions pair with. Versioned because a hand image
# change needs a fresh golden — bump when you rebuild the hand.
export HAND_TEMPLATE="hand-v6"
# Public entry point. After `gcloud compute addresses create agentplane-ip`,
# put the reserved address here.
export INGRESS_IP="136.68.213.85"
# Hostname for the HTTPS cutover. Until a domain exists, nip.io off the IP.
export INGRESS_HOST="${INGRESS_IP}.nip.io"

# --- observability ------------------------------------------------------------
export OTEL_ENDPOINT="http://opentelemetry-collector.otel-system.svc:4317"
